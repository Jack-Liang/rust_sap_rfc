# ──────────────────────────────────────────────────────────────
# SAP 连接参数（本地运行 & Docker 都需要）
# ──────────────────────────────────────────────────────────────
SAP_ASHOST=localhost
SAP_SYSNR=00
SAP_CLIENT=001
SAP_USER=DEVELOPER
SAP_PASSWD=your-password-here

# 语言（可选，默认 EN）
SAP_LANG=EN

# HTTP 服务监听地址（本地运行用；Docker 内部固定监听 0.0.0.0:3000）
SAP_LISTEN_ADDR=127.0.0.1:3000

# ──────────────────────────────────────────────────────────────
# 仅 Docker 部署时需要（docker compose up 用）
# ──────────────────────────────────────────────────────────────

# 宿主机上 Linux 版 SAP SDK 目录的【绝对路径】。
# 该目录会被只读挂载到容器的 /app/nwrfcsdk。
# 目录结构需与仓库 nwrfcsdk/ 一致，含 lib/linux-x86_64/libsapnwrfc.so。
# 示例：
#   Windows: SAP_SDK_HOST_PATH=C:\Users\you\sap-sdk
#   Linux:   SAP_SDK_HOST_PATH=/opt/sap/nwrfcsdk
# 本地运行（非 Docker）时无需配置此项。
SAP_SDK_HOST_PATH=./nwrfcsdk

# 宿主机映射端口（默认 3000）。改此值不影响容器内监听。
SAP_HOST_PORT=3000

# 日志级别（tracing env_filter）。可选值：error/warn/info/debug/trace
RUST_LOG=info
